# Copy to backend/.env for local development.
ENVIRONMENT=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Default is SQLite (a file next to where you start the app). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://brightloop:brightloop_dev@localhost:5432/brightloop
DATABASE_URL=sqlite:///./brightloop.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=60
# Optional: creates this ADMIN on startup if it does not exist.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173
ALLOW_OVERPAYMENT=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Brightloop <noreply@brightloop.local>

# Razorpay TEST MODE only (rzp_test_ keys; live keys are refused). See docs/RAZORPAY.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
