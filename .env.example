# Copy to backend/.env, then edit (`run.cmd` creates it for you).
# Generate a secret with:  openssl rand -hex 32
SECRET_KEY=
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=
POSTGRES_DB=brightloop

# Optional: auto-create an ADMIN account on backend start (needed to create staff / call the Celery check).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Set true when served over HTTPS
COOKIE_SECURE=false
VITE_API_URL=http://localhost:8000/api/v1

# Email. Leave SMTP_HOST empty in development: emails (password reset, reminders) are printed to the backend log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Brightloop <noreply@brightloop.local>

# Invoice PDF letterhead
BUSINESS_NAME=Brightloop
BUSINESS_TAGLINE=Subscription management
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_TAX_ID=
PAYMENT_INSTRUCTIONS=Pay online from your Brightloop customer portal, or by bank transfer quoting the invoice number.

# Razorpay TEST MODE only (rzp_test_ keys; live keys are refused). See docs/RAZORPAY.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email delivery: auto = Celery when Redis is reachable, otherwise a background thread (inline = synchronous, used by tests)
EMAIL_DELIVERY=auto
